# Local database stack
DB_NAME=untitledplatform_1a
DB_USER=untitled
DB_PASSWORD=CHANGE_ME
DB_PORT=5435
PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=CHANGE_ME
PGADMIN_PORT=5051
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Runtime database URLs
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:${DB_PORT}/${DB_NAME}
# Test DB must be an isolated database distinct from any live/production DB.
# The integration suite writes via DATABASE_URL (create_session) and reads back via
# TEST_DATABASE_URL, so during testing both point at this same isolated test DB.
# Set both DATABASE_URL and TEST_DATABASE_URL to the isolated test database when testing.
# TEST_DATABASE_URL=postgresql://untitled:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5435/blackrabbit_test  # pragma: allowlist secret
# Read-only role on the same DB the API serves (operator-ui INV-002: GRANT SELECT-only
# direct-SQL path). Create the role with GRANT SELECT only; writes go through the
# wrapped backend contracts, never this connection. Set the role's password in
# your local .env (e.g. ...://untitled_api_ro:<password>@...), never here.
# API_READONLY_DATABASE_URL=postgresql://untitled_api_ro:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5435/untitledplatform_1a  # pragma: allowlist secret

# --- Operator UI tenancy (optional Python-side; absence must not fail validate(); INV-015) ---
# Server-injected tenant context for the API (one sponsor/site per local deployment).
# API_SPONSOR_ID=00000000-0000-0000-0000-000000000000
# API_SITE_ID=00000000-0000-0000-0000-000000000000
# Optional Python investigator. The scripted portfolio demo needs none of these.
# Set INVESTIGATION_MODEL to an explicit openai:<model> or anthropic:<model>.
# Provider credentials, when configured locally, use OPENAI_API_KEY or ANTHROPIC_API_KEY.
#
# The operator UI's own env vars (API_BASE_URL, AGENT_BASE_URL, AGENT_MODEL,
# AGENT_API_KEY, NEXT_PUBLIC_API_URL) live ONLY in the JS env — see
# web/.env.example, never config/settings.py (frontend-shell INV-009).

# Directories
LOG_DIR=./logs
XDF_BACKUP_DIR=./data/xdf_backups

# LSL stream names
LSL_STREAM_EEG=EEG
LSL_STREAM_HRV=HRV
LSL_STREAM_EDA=EDA
LSL_STREAM_RESPIRATION=Respiration
LSL_STREAM_MARKER=ECHOMarkers
LSL_RESOLVE_TIMEOUT=5.0
LSL_MAX_BUFSIZE=10.0
LSL_CHUNK_EEG=25
LSL_CHUNK_HRV=1
LSL_CHUNK_EDA=4
LSL_CHUNK_RESPIRATION=4

# Sample rates and EEG layout
SAMPLE_RATE_EEG=250
SAMPLE_RATE_HRV=1
SAMPLE_RATE_EDA=4
SAMPLE_RATE_RESPIRATION=4
EEG_CHANNEL_COUNT=8
# EEG_CHANNEL_NAMES=Fp1,Fp2,F3,F4,C3,C4,O1,O2

# Device identity
# Override this per recording machine before multi-device or shared-DB use.
DEVICE_ID=00000000-0000-0000-0000-000000000001

# Capture source
CAPTURE_SOURCE=simulated
SIMULATED_ECHO_MARKER_INTERVAL=5.0
APP_VERSION=unknown
PAYLOAD_SCHEMA_VERSION=1.0

# Watchdog and drift
WATCHDOG_TIMEOUT_EEG=3.0
WATCHDOG_TIMEOUT_HRV=10.0
WATCHDOG_TIMEOUT_EDA=10.0
WATCHDOG_TIMEOUT_RESPIRATION=10.0
WATCHDOG_POLL_INTERVAL=1.0
CLOCK_DRIFT_RECORD_INTERVAL=60.0

# Deferred monitor placeholders
SAFETY_MONITOR_POLL_INTERVAL=1.0
SQI_MONITOR_POLL_INTERVAL=5.0

# Recording metadata
EEG_REFERENCE=average
EEG_SENSOR_FORM=cap
EEG_ELECTRODE_SYSTEM=ten_twenty
EEG_ELECTRODE_TYPE=unknown
POWER_LINE_FREQUENCY=60.0
# CAP_MANUFACTURER=
# CAP_MANUFACTURER_MODEL_NAME=
HRV_SIGNAL_SOURCE=ecg
HRV_ELECTRODE_PLACEMENT=unknown
HRV_ELECTRODE_TYPE=unknown
# BEAT_DETECTION_ALGORITHM=
# BEAT_DETECTION_VERSION=
EDA_SIGNAL_SOURCE=combined
# EDA_RANGE_MIN_US=
# EDA_RANGE_MAX_US=
RESPIRATION_SOURCE=belt_direct
# RESPIRATION_UNIT=
