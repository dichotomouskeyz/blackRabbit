{
  "schema_version": 1,
  "project": {
    "name": "untitled_biometric_platform-1a",
    "language": "python",
    "description": "Local research-tool MVP for labs studying neuro-behavioral sessions. Captures synchronized physiology (APEX/EEG/HRV/EDA) and event context (ECHO), supports post-session ARC analysis."
  },
  "commands": {
    "test": "uv run pytest",
    "_test_python": "uv run pytest",
    "test_frontend": "corepack pnpm@9.15.9 -C web test",
    "test_e2e": "corepack pnpm@9.15.9 -C web test:e2e",
    "_test_gate_note": "Python is the default backend gate. Frontend changes use test_frontend and lint_frontend after the separately owned web package is committed.",
    "test_verbose": "uv run pytest -v",
    "coverage": "uv run pytest --cov",
    "lint": "uv run ruff check .",
    "lint_frontend": "corepack pnpm@9.15.9 -C web lint",
    "build": "corepack pnpm@9.15.9 -C web build"
  },
  "patterns": {
    "test_file": "test_*.py|*_test.py|tests/**/*|web/tests/**|web/**/*.test.ts|web/**/*.test.tsx",
    "source_file": "*.py|web/src/**/*.ts|web/src/**/*.tsx",
    "test_fail_pattern": "FAILED|ERROR|failed|✗|FAIL ",
    "build_error_pattern": "Failed to compile|Type error"
  },
  "is_monorepo": false,
  "packages": {},
  "workflow": {
    "min_qa_rounds": 1,
    "require_review": true,
    "auto_update_antipatterns": true,
    "git_trailers": false,
    "git_notes": false,
    "branching_strategy": "feature-branches",
    "merge_strategy": "squash",
    "commit_style": "conventional",
    "pr_template": ".github/pull_request_template.md"
  },
  "mcp": {
    "serena": true,
    "context7": true
  },
  "setup": {
    "architecture_state": "in-progress",
    "agent_context_state": "complete"
  },
  "release": {
    "version_file": "pyproject.toml",
    "version_pattern": "version[[:space:]]*=[[:space:]]*\"[^\"]*\""
  }
}
