# blackRabbit operator UI (web/) — JS-env only; never config/settings.py (frontend-shell INV-009).
# Copy to web/.env.local (gitignored) and adjust.

# Where the Next.js server reaches the FastAPI api/ surface (server-only). The
# browser calls /backend/* on the UI's own origin and Next forwards it here, so
# FastAPI needs no CORS policy.
API_BASE_URL=http://localhost:8000

# --- Agent route (server-only; never NEXT_PUBLIC_, never the browser bundle; PRH-005) ---
# Any OpenAI-compatible endpoint with tool calling; the route POSTs to
# ${AGENT_BASE_URL}/chat/completions. Examples:
#   LiteLLM proxy:  http://localhost:4000
#   Ollama:         http://localhost:11434/v1   (AGENT_MODEL=qwen3:8b, for example)
# Must be loopback / RFC-1918 private (frontend-shell INV-013) — no public hosts.
AGENT_BASE_URL=http://localhost:4000
AGENT_MODEL=local-model
# Many local servers ignore the key; LiteLLM may require a placeholder.
AGENT_API_KEY=
