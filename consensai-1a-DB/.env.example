# Consensai 1a — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is gitignored. This file (.env.example) is committed.

# --- Database ---
DB_NAME=consensai
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- pgAdmin ---
PGADMIN_EMAIL=admin@consensai.local
PGADMIN_PASSWORD=

# --- XDF Backup ---
XDF_BACKUP_DIR=./data/xdf_backups

# --- Logging ---
LOG_DIR=./logs
